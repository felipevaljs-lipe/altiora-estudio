{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteLeads",
      "Effect": "Allow",
      "Action": ["dynamodb:PutItem"],
      "Resource": "arn:aws:dynamodb:us-east-1:229975483756:table/EstudioNubeLeads"
    },
    {
      "Sid": "SendContactEmail",
      "Effect": "Allow",
      "Action": ["ses:SendEmail"],
      "Resource": "*"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:229975483756:*"
    }
  ]
}
